# =============================================================================
# Secrets are managed by Doppler (https://dashboard.doppler.com/workplace/projects)
# Run `doppler setup` to link this repo if not already configured.
# Run `doppler run -- <command>` to inject secrets automatically.
#
# If you don't use Doppler, copy this file to .env and fill in the values below.
# =============================================================================

# Database (Neon/PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Cloudflare R2 (file storage)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.r2.cloudflarestorage.com

# App URLs
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Absolute origin embedded in outbound links (e.g. inquiry notification emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Sentry (optional — disable by leaving unset)
SENTRY_DSN=https://your-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Resend (email)
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=noreply@yourdomain.com

# Polar (payments)
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
# One Polar product per paid plan; checkout maps plan -> product by these ids.
POLAR_PRODUCT_ID_PRO=your-polar-pro-product-id
POLAR_PRODUCT_ID_ENTERPRISE=your-polar-enterprise-product-id

# Upstash Redis (optional) — shared rate-limit store. When unset the limiter
# falls back to a per-instance in-memory window, which is much weaker on
# serverless because each instance counts separately.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Demo tenant onboarding bypass. Note the default is ENABLED: only the literal
# value "false" turns it off, so set it explicitly in any real deployment.
ENABLE_DEMO_ONBOARDING_BYPASS=false
