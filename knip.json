{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/loading.tsx",
    "src/app/**/not-found.tsx",
    "src/app/**/error.tsx",
    "src/app/**/route.ts",
    "src/app/**/actions.ts",
    "src/i18n/navigation.ts",
    "src/i18n/request.ts",
    "src/proxy.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": ["postcss"],
  "ignoreExportsUsedInFile": true
}
