{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/loading.tsx",
    "src/app/**/not-found.tsx",
    "src/app/**/error.tsx",
    "src/app/**/route.ts",
    "src/app/**/actions.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/db/schema.ts"],
  "ignoreDependencies": ["postcss"],
  "ignoreExportsUsedInFile": true
}
